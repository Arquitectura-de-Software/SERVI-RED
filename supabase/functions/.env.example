# Copiar a supabase/functions/.env (NO se sube al repositorio) y llenar con valores LOCALES.
# Lo usa la Edge Function superset-guest-token (Persona 4).
# Cuenta de servicio de Superset con permiso para pedir guest tokens (no la de admin).
SUPERSET_URL=http://host.docker.internal:8088
SUPERSET_USER=
SUPERSET_PASSWORD=
# UUID del dashboard embebido (Superset: Dashboard > ... > Embed dashboard).
SUPERSET_DASHBOARD_ID=
