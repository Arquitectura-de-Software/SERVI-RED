## Credenciales de Supabase (Cloud o Local)
# Copia este archivo como 'secrets.properties' en la raíz de 'app-movil/'.
# Este archivo no se versiona (ignorado en .gitignore).

# Para Supabase Cloud:
# SUPABASE_URL=https://<TU-PROYECTO-ID>.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Para Supabase Local (en emulador Android, 10.0.2.2 apunta al localhost del host):
# SUPABASE_URL=http://10.0.2.2:54321
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
